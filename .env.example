# Server
PORT=3100
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:7002

# Auth (matches sister APIs)
JWT_SECRET=change-me-in-production
SESSION_SECRET=change-me-in-production
REDIS_URL=redis://localhost:6379

# AI Provider (openai | opencode | anthropic | local)
AI_PROVIDER=opencode
AI_API_KEY=your-opencode-go-api-key
AI_MODEL=qwen3.7-plus
AI_BASE_URL=

# Product API URLs (for tool execution)
GYMFLOW_API_URL=http://localhost:7001/api
ZIGNALOBBY_API_URL=http://localhost:7003/api

# Shared secret for product API sourceGuard (must match product .env)
VIGIL_SECRET=change-me-to-a-long-random-string

# Rate Limiting (per business entity)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
